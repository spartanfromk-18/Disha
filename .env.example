# Disha — environment template.
# Copy to `.env` and fill in values. NEVER commit `.env` (it's gitignored).
#
# Today Disha runs fully keyless on OpenStreetMap, so every key below is
# optional. Fill one in only when you enable the feature that needs it.

# Reserved: embedded Google Maps (future — today we use deep links, no key needed)
GOOGLE_MAPS_API_KEY=

# Reserved: weather briefings before a trip (future)
OPENWEATHER_API_KEY=

# Geospatial backends (sane defaults; override only if self-hosting)
NOMINATIM_BASE=https://nominatim.openstreetmap.org
OVERPASS_BASE=https://overpass-api.de/api/interpreter

# App tuning
DEFAULT_LANG=en-IN
NEARBY_RADIUS_M=1500
CHIME_RADIUS_M=100
ARRIVAL_RADIUS_M=12

# Build
NODE_ENV=production
